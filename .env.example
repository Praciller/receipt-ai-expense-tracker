# Receipt inference
MOCK_AI_MODE=true
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_RETRY_BACKOFF_SECONDS=2
ENABLE_AI_PARSE_CACHE=true
AI_PARSE_CACHE_TTL_SECONDS=86400
AI_PARSE_CACHE_DIR=.cache/ai
ENABLE_SAFE_FALLBACK=true
RETURN_PROVIDER_METADATA=true

# Optional generic external inference
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_BASE_URL=
EXTERNAL_AI_CHAT_PATH=/v1/chat/completions
EXTERNAL_AI_MODEL=
EXTERNAL_AI_FALLBACK_MODEL=
EXTERNAL_AI_JSON_REPAIR_MODEL=
EXTERNAL_AI_SUPPORTS_IMAGE_INPUT=true

# Browser storage
NEXT_PUBLIC_STORAGE_MODE=indexeddb

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_RECEIPT_IMAGE_MB=5
